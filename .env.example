# =============================================================================
# ZbudujKompa — build-time configuration
#
# Copy to .env.local for local development. Every variable here is compiled
# into the static output, so treat all of them as public.
# =============================================================================

# Canonical site address. Used for absolute URLs in metadata, Open Graph tags,
# structured data and the sitemap.
NEXT_PUBLIC_SITE_URL=https://zbudujkompa.dawidolko.pl

# Sub-path prefix. Leave empty for a custom domain or a user/org Pages site.
# Set to "/<repository>" when publishing to https://<user>.github.io/<repo>/.
NEXT_PUBLIC_BASE_PATH=

# -----------------------------------------------------------------------------
# Optional: remote chat provider
#
# The build assistant works without any of these, answering from the knowledge
# base compiled into the site. Setting them adds an LLM on top, with the local
# answers still used as the fallback whenever a request fails.
#
# IMPORTANT: this site is a static export. There is no server to hold a secret,
# so a key set here is readable by anyone who opens the JavaScript bundle. Only
# use a free-tier key you are willing to treat as public and can rotate, and
# set a spending limit on it. Never put a paid key here.
#
# Any OpenAI-compatible endpoint works. Providers with a free tier include
# Groq and OpenRouter — create the key in their dashboard yourself.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CHAT_API_URL=
NEXT_PUBLIC_CHAT_API_KEY=
NEXT_PUBLIC_CHAT_MODEL=
