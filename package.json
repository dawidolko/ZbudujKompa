{
  "name": "zbudujkompa",
  "version": "2.0.0",
  "private": true,
  "description": "ZbudujKompa \u2014 bilingual PC building guide: platforms, cooling, reference builds and step-by-step instructions. Next.js 16, Tailwind CSS 4, fully static export.",
  "type": "module",
  "license": "MIT",
  "author": "Dawid Olko",
  "homepage": "https://zbudujkompa.dawidolko.pl",
  "repository": {
    "type": "git",
    "url": "https://github.com/dawidolko/ZbudujKompa.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "npx --yes serve@latest out -l 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css,md,json,yml}\"",
    "test:theme": "node tests/theme.spec.mjs",
    "test:a11y": "node tests/a11y.spec.mjs",
    "test": "npm run test:chat && npm run test:compat && npm run test:theme && npm run test:interaction && npm run test:a11y",
    "verify": "npm run check:secrets && npm run typecheck && npm run lint && npm run format:check && npm run build",
    "docker:build": "docker compose -f .tools/docker/docker-compose.yml build",
    "docker:up": "docker compose -f .tools/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f .tools/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f .tools/docker/docker-compose.yml logs -f",
    "docker:dev": "docker compose -f .tools/docker/docker-compose.yml --profile dev up",
    "test:interaction": "node tests/interaction.spec.mjs",
    "brand:assets": "node .tools/scripts/generate-brand-assets.mjs",
    "chat:key": "node .tools/scripts/setup-chat-key.mjs",
    "check:secrets": "node .tools/scripts/check-secrets.mjs",
    "photos:fetch": "node .tools/scripts/fetch-photos.mjs",
    "test:chat": "node --experimental-strip-types tests/chat.spec.mjs",
    "test:compat": "node --experimental-strip-types tests/compatibility.spec.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.10.2",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.49.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
